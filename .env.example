# GEO Ride Environment Configuration Template
# Copy this file to '.env' and insert your valid Mapbox Access Token.
#
# IMPORTANT SECURITY NOTE:
# The Mapbox public token (pk.*) will be bundled into client-side JS.
# To prevent unauthorized usage and quota consumption, ALWAYS configure URL Restrictions
# in your Mapbox Dashboard (Account -> Access Tokens -> Edit Token -> URL Restrictions):
# e.g.:
#   https://playgeoride.com/*
#   http://localhost:*

VITE_MAPBOX_TOKEN=pk.eyJ1IjoieW91ci11c2VybmFtZSIsImEiOiJjb3lvdXJ0b2tlbmhlcmUifQ.example_token_string
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your_supabase_anon_key

# High-Performance Binary Multiplayer Server (Optional - falls back to public MQTT if not set)
# Production: wss://mp.playgeoride.com (or your Render / Fly.io / Oracle Cloud free tier instance)
# Local development: ws://localhost:8080
VITE_MP_URL=

# Server Environment Variables (for running 'npm run server'):
# PORT=8080
# SUPABASE_URL=https://your-project.supabase.co
# SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key
# ALLOWED_ORIGINS=https://playgeoride.com,https://staging.playgeoride.com,http://localhost:5173,http://localhost:8080

