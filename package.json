{
    "name": "geo-ride",
    "version": "1.0.0",
    "description": "3D Driving Simulator using Mapbox",
    "type": "module",
    "scripts": {
        "dev": "vite",
        "build": "vite build",
        "preview": "vite preview",
        "test": "node --experimental-test-coverage --test tests/*.test.js",
        "test:e2e": "playwright test",
        "lint": "eslint js/*.js app.js",
        "format": "prettier --write .",
        "size": "node js/check-size.js",
        "prepare": "husky"
    },
    "devDependencies": {
        "@eslint/js": "^9.20.0",
        "@playwright/test": "^1.41.0",
        "esbuild": "^0.28.1",
        "eslint": "^10.8.0",
        "globals": "^15.15.0",
        "husky": "^9.0.0",
        "lint-staged": "^15.0.0",
        "prettier": "^3.2.0",
        "serve": "^14.2.1",
        "vite": "^8.2.0"
    },
    "lint-staged": {
        "*.js": [
            "eslint --fix",
            "prettier --write"
        ],
        "*.{json,md,html,css}": [
            "prettier --write"
        ]
    }
}
